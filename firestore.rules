rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userPhone() {
      return userDoc().data.phone;
    }

    function userEstablishmentIds() {
      return userDoc().data.keys().hasAny(['establishments'])
        ? userDoc().data.establishments
        : userDoc().data.establishmentIds;
    }

    function hasLegacyEstablishment(establishmentId) {
      return userDoc().data.establishmentId == establishmentId;
    }

    function hasMultiEstablishment(establishmentId) {
      return userEstablishmentIds() is list
        && establishmentId in userEstablishmentIds();
    }

    function teamExists(establishmentId) {
      return exists(
        /databases/$(database)/documents/establishments/$(establishmentId)/team/$(request.auth.uid)
      );
    }

    function memberExists(establishmentId) {
      return exists(
        /databases/$(database)/documents/establishments/$(establishmentId)/members/$(request.auth.uid)
      );
    }

    function isEstablishmentMember(establishmentId) {
      return isSignedIn()
        && (hasLegacyEstablishment(establishmentId)
          || hasMultiEstablishment(establishmentId))
        && (teamExists(establishmentId) || memberExists(establishmentId));
    }

    function teamRole(establishmentId) {
      return get(
        /databases/$(database)/documents/establishments/$(establishmentId)/team/$(request.auth.uid)
      ).data.roleId;
    }

    function memberRole(establishmentId) {
      return teamExists(establishmentId)
        ? teamRole(establishmentId)
        : get(
            /databases/$(database)/documents/establishments/$(establishmentId)/members/$(request.auth.uid)
          ).data.role;
    }

    function hasEstablishmentRole(establishmentId, roles) {
      return isEstablishmentMember(establishmentId)
        && memberRole(establishmentId) in roles;
    }

    function canManageEstablishment(establishmentId) {
      return hasEstablishmentRole(establishmentId, ['owner', 'manager']);
    }

    // Agent/Gérant : owner ou manager. Propriétaire : uniquement un owner.
    function canAssignInviteRole(establishmentId, roleId) {
      return (roleId in ['manager', 'agent']
          && canManageEstablishment(establishmentId))
        || (roleId == 'owner'
          && hasEstablishmentRole(establishmentId, ['owner']));
    }

    function isInvitableRole(roleId) {
      return roleId in ['owner', 'manager', 'agent'];
    }

    function isValidUserSignup() {
      return isSignedIn()
        && request.resource.data.phoneVerified == false
        && request.resource.data.fullName is string
        && request.resource.data.phone is string
        && (request.resource.data.establishments is list
          || request.resource.data.establishmentIds is list)
        && request.resource.data.rolesByEstablishment is map
        && request.resource.data.role is string;
    }

    function isValidEstablishmentSignup() {
      return isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.phoneVerified == false
        && request.resource.data.category is string
        && request.resource.data.name is string
        && request.resource.data.managerName is string
        && request.resource.data.phone is string;
    }

    function isValidTeamOwnerCreate(memberId) {
      return isSignedIn()
        && request.auth.uid == memberId
        && request.resource.data.userId == memberId
        && request.resource.data.roleId == 'owner'
        && request.resource.data.phoneVerified == false;
    }

    function isValidMemberSignup(memberId) {
      return isSignedIn()
        && request.auth.uid == memberId
        && request.resource.data.uid == memberId
        && request.resource.data.establishmentId is string
        && request.resource.data.role == 'owner'
        && request.resource.data.phoneVerified == false;
    }

    function userInvitationDoc(invitationId) {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)/invitations/$(invitationId)
      );
    }

    function isValidInvitedTeamCreate(establishmentId, memberId) {
      let invitation = userInvitationDoc(request.resource.data.sourceInvitationId);
      return isSignedIn()
        && request.auth.uid == memberId
        && request.resource.data.userId == memberId
        && isInvitableRole(request.resource.data.roleId)
        && invitation.data.status == 'pending'
        && invitation.data.invitedPhone == userPhone()
        && (invitation.data.roleId == request.resource.data.roleId
          || invitation.data.role == request.resource.data.roleId);
    }

    function isValidInvitedMemberCreate(establishmentId, memberId) {
      let invitation = userInvitationDoc(request.resource.data.sourceInvitationId);
      return isSignedIn()
        && request.auth.uid == memberId
        && request.resource.data.uid == memberId
        && request.resource.data.establishmentId == establishmentId
        && request.resource.data.phone == userPhone()
        && isInvitableRole(request.resource.data.role)
        && invitation.data.status == 'pending'
        && invitation.data.invitedPhone == userPhone()
        && (invitation.data.roleId == request.resource.data.role
          || invitation.data.role == request.resource.data.role);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if request.auth.uid == userId && isValidUserSignup();
      // Self-update (fullName, email reporting, activeEstablishmentId, etc.).
      // email optionnel : string non vide quand présent (reporting hebdo/mensuel).
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && (!('email' in request.resource.data)
          || (request.resource.data.email is string
            && request.resource.data.email.size() > 2));

      match /invitations/{invitationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        // Owner/manager invite un user déjà inscrit (écrit dans l'inbox du destinataire)
        allow create: if isSignedIn()
          && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.status == 'pending'
          && canAssignInviteRole(
            request.resource.data.establishmentId,
            request.resource.data.roleId
          );
        // Claim : le destinataire copie une pendingInvitation dans son inbox
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.invitedPhone == userPhone()
          && request.resource.data.status == 'pending'
          && isInvitableRole(request.resource.data.roleId);
        // Accept / refuse par le destinataire
        allow update: if isSignedIn()
          && request.auth.uid == userId
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'revoked']
          && request.resource.data.establishmentId == resource.data.establishmentId;
      }
    }

    match /phoneIndex/{phone} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
    }

    match /pendingInvitations/{invitationId} {
      allow read: if isSignedIn()
        && resource.data.invitedPhone == userPhone();
      allow create: if isSignedIn()
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && canAssignInviteRole(
          request.resource.data.establishmentId,
          request.resource.data.roleId
        );
      // Claim : destinataire marque claimed après copie inbox
      allow update: if isSignedIn()
        && resource.data.invitedPhone == userPhone()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedBy == request.auth.uid;
    }

    match /phone_verifications/{userId} {
      allow read, write: if false;
    }

    match /establishments/{establishmentId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow read: if isEstablishmentMember(establishmentId);
      allow create: if isValidEstablishmentSignup();
      allow update: if canManageEstablishment(establishmentId);

      match /team/{memberId} {
        allow read: if isEstablishmentMember(establishmentId);
        allow read: if isSignedIn() && request.auth.uid == memberId;
        allow create: if isValidTeamOwnerCreate(memberId)
          || isValidInvitedTeamCreate(establishmentId, memberId);
        allow update, delete: if canManageEstablishment(establishmentId);
      }

      // Legacy — lecture/écriture pendant migration douce
      match /members/{memberId} {
        allow read: if isEstablishmentMember(establishmentId);
        allow read: if isSignedIn() && request.auth.uid == memberId;
        allow create: if isValidMemberSignup(memberId)
          || isValidInvitedMemberCreate(establishmentId, memberId);
        allow update, delete: if canManageEstablishment(establishmentId);
      }

      match /invitations/{invitationId} {
        allow read: if canManageEstablishment(establishmentId);
        allow read: if isSignedIn() && resource.data.invitedPhone == userPhone();
        allow create: if canManageEstablishment(establishmentId);
        allow update: if canManageEstablishment(establishmentId);
        allow delete: if canManageEstablishment(establishmentId);
      }

      match /{collection}/{docId} {
        allow read, write: if isEstablishmentMember(establishmentId)
          && collection in [
            'clients', 'vehicules', 'categories', 'services',
            'product_categories', 'produits',
            'prestations', 'ventes', 'jetons',
            'alertes', 'notifications',
            'commandes', 'ligne_commandes', 'factures', 'paiements'
          ];
      }
    }
  }
}
